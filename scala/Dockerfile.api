# ---- build asamasi ----
FROM sbtscala/scala-sbt:eclipse-temurin-17.0.19_10_1.12.15_2.12.21 AS build

WORKDIR /build

# Once build tanimlari: bagimlilik cozumu kod degisiminde tekrarlanmasin
COPY build.sbt .
COPY project/ project/
RUN sbt update

COPY common/ common/
COPY rec-api/ rec-api/

# Testler build'in parcasi: ranking formulu bozuksa image olusmaz
RUN sbt common/test recApi/test "recApi/assembly"

# ---- calisma asamasi ----
FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/rec-api/target/scala-2.12/rec-api.jar /app/rec-api.jar

EXPOSE 8081

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/rec-api.jar"]
